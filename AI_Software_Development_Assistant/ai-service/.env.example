# Copy to ai-service/.env. NEVER share API keys.
AI_INTERNAL_KEY=REPLACE_WITH_THE_SAME_RANDOM_SHARED_KEY_IN_BOTH_SERVICES
AI_API_KEY=
AI_BASE_URL=https://api.fastrouter.ai/api/v1
AI_MODEL=fastrouter/auto
# Leave empty if router does not support embeddings; lexical RAG will still work.
AI_EMBEDDING_MODEL=
AI_FORCE_JSON_RESPONSE_FORMAT=false
RAG_DATA_DIR=./data
# Optional: enables searching NEW pages in approved official documentation domains.
# Tavily is preferred (one basic search request per lookup). Never commit a real key.
# If no provider key is set, the curated catalog remains available.
TAVILY_API_KEY=
# Backwards compatibility for users who already have a Brave Search subscription.
BRAVE_SEARCH_API_KEY=
