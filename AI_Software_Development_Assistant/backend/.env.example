# Copy to backend/.env. NEVER commit or share passwords.
DB_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=AI_Software_Assistant;encrypt=true;trustServerCertificate=true
DB_USER=ai_app
DB_PASSWORD=REPLACE_WITH_YOUR_SQL_PASSWORD
DB_DDL_AUTO=update
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
AI_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_KEY=REPLACE_WITH_THE_SAME_RANDOM_SHARED_KEY_IN_BOTH_SERVICES
CORS_ORIGIN=http://localhost:5173

# EMAIL OTP – Gmail requires a Google App Password (not your Gmail login password).
# Set these only in backend/.env; never commit real values to Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=YOUR_16_CHAR_APP_PASSWORD
MAIL_FROM=your-address@gmail.com
